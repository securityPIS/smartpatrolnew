VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-or-cloud-anon-key
VITE_ENABLE_CLOUD_SYNC=1
VITE_ENABLE_CLOUD_SYNC_WRITE=1
VITE_TRUSTED_TIME_URL=http://127.0.0.1:54321/functions/v1/server-time

# Foto full-res ke Cloudflare R2. 0/kosong = Supabase-only (degradasi mulus, perilaku lama).
# Aktifkan (1) hanya bila secret R2 di bawah sudah di-set di Edge Functions.
VITE_ENABLE_R2_FULL_PHOTO=0

# Server-side only. Jangan expose ke client/browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SMARTPATROL_SETUP_TOKEN=replace-with-local-setup-token

# Cloudflare R2 (server-only, set via: supabase secrets set ...). Bucket WAJIB privat.
R2_ACCOUNT_ID=replace-with-r2-account-id
R2_BUCKET=replace-with-r2-bucket-name
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
